# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Frontend URL (where the Next.js app is deployed)
FRONTEND_URL=https://veloai.pro

# Shared secret — must match BAILEYS_BRIDGE_SECRET in the frontend .env
# NOTE: use a DIFFERENT secret than the old velo-bridge while testing side by side
BRIDGE_SECRET=velo-bridge-baileys-dev-secret

# Server — different port from the old bridge (3001) so both can run at once
PORT=3002
